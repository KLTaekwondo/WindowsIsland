<Window x:Class="WindowsIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsIsland"
        Title="WindowsIsland"
        Icon="/app.ico"
        Width="720"
        Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 卡片：细微的顶部提亮 + 柔和描边，避免一整块死板的纯色 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#1FFFFFFF" />
                        <GradientStop Offset="0.12" Color="#12FFFFFF" />
                        <GradientStop Offset="1" Color="#0AFFFFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#7AFFFFFF" />
        </Style>

        <Style x:Key="TabChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,4,11,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="Island"
                Width="144"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,10,0,0"
                ClipToBounds="True"
                Cursor="Hand"
                MouseLeftButtonDown="OnIslandMouseDown"
                MouseLeftButtonUp="OnIslandMouseUp"
                MouseWheel="OnIslandWheel">

            <!-- 圆角随「上边距 + 高度」逐帧计算：贴顶后上方两角归零。 -->
            <Border.CornerRadius>
                <MultiBinding Converter="{x:Static local:IslandRadiusConverter.Instance}">
                    <Binding ElementName="Island" Path="Margin" />
                    <Binding ElementName="Island" Path="ActualHeight" />
                </MultiBinding>
            </Border.CornerRadius>

            <!-- 圆角几何裁剪：ClipToBounds 只裁矩形，进度线会在底部圆角处漏出去 -->
            <Border.Clip>
                <MultiBinding Converter="{x:Static local:IslandClipConverter.Instance}">
                    <Binding ElementName="Island" Path="Margin" />
                    <Binding ElementName="Island" Path="ActualHeight" />
                    <Binding ElementName="Island" Path="ActualWidth" />
                </MultiBinding>
            </Border.Clip>

            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#FF2A2A33" />
                    <GradientStop Offset="0.55" Color="#FF15151A" />
                    <GradientStop Offset="1" Color="#FF0A0A0D" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.RenderTransform>
                <TranslateTransform x:Name="IslandShake" />
            </Border.RenderTransform>

            <Border.BorderThickness>1</Border.BorderThickness>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#3DFFFFFF" />
                    <GradientStop Offset="0.5" Color="#18FFFFFF" />
                    <GradientStop Offset="1" Color="#0CFFFFFF" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>

                <!-- 液态玻璃附加层（非玻璃模式下透明度为 0） -->
                <Rectangle x:Name="GlassTint" IsHitTestVisible="False" Opacity="0" />
                <Rectangle x:Name="GlassTopSpecular" IsHitTestVisible="False" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.28">
                            <GradientStop Offset="0" Color="#3DFFFFFF" />
                            <GradientStop Offset="0.4" Color="#10FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="GlassBottomShade" IsHitTestVisible="False" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0.55" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#38000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- 收起态：只放时间 -->
                <Border x:Name="AlertGlow"
                        BorderThickness="2"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.CornerRadius>
                        <MultiBinding Converter="{x:Static local:IslandRadiusConverter.Instance}">
                            <Binding ElementName="Island" Path="Margin" />
                            <Binding ElementName="Island" Path="ActualHeight" />
                        </MultiBinding>
                    </Border.CornerRadius>
                </Border>

                <Grid x:Name="CollapsedPanel" Opacity="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- 三根跳动的“均衡器”柱：有音乐时才有生命感 -->
                        <StackPanel x:Name="EqualizerBars" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0" Opacity="0">
                            <Rectangle x:Name="Bar0" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="#FF5BE49B" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Rectangle x:Name="Bar1" Width="2.5" Height="9" RadiusX="1.25" RadiusY="1.25" Fill="#FF5BE49B" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <Rectangle x:Name="Bar2" Width="2.5" Height="6" RadiusX="1.25" RadiusY="1.25" Fill="#FF5BE49B" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="CollapsedTimeText"
                                   Text="00:00:00"
                                   FontSize="11.5"
                                   Foreground="#C4FFFFFF"
                                   TextOptions.TextFormattingMode="Ideal"
                                   TextOptions.TextRenderingMode="ClearType" />
                    </StackPanel>
                </Grid>

                <!-- 斜向高光：给纯黑表面一点反光（静态，无模糊开销） -->
                <Rectangle IsHitTestVisible="False" Opacity="0.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#00FFFFFF" />
                            <GradientStop Offset="0.42" Color="#12FFFFFF" />
                            <GradientStop Offset="0.5" Color="#1AFFFFFF" />
                            <GradientStop Offset="0.58" Color="#12FFFFFF" />
                            <GradientStop Offset="1" Color="#00FFFFFF" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 媒体进度线 -->
                <Border x:Name="ProgressTrack"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Background="#22FFFFFF"
                        Opacity="0" />
                <Border x:Name="ProgressFill"
                        Height="2"
                        CornerRadius="1"
                        VerticalAlignment="Bottom"
                        Background="#FF5BE49B"
                        Opacity="0"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                    </Border.RenderTransform>
                </Border>

                <!-- 钉住指示线 -->
                <Border x:Name="PinnedLine"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Background="#66FFFFFF"
                        Opacity="0" />

                <Grid x:Name="ContentRoot" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ContentScale" ScaleX="0.93" ScaleY="0.93" />
                    </Grid.RenderTransform>

                    <!-- ========== 小卡片：时钟 ========== -->
                    <Grid x:Name="ClockPanel" Margin="22,9,20,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeText"
                                       Text="00:00"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#F7FFFFFF"
                                       TextOptions.TextFormattingMode="Ideal"
                                       TextOptions.TextRenderingMode="ClearType" />
                            <TextBlock x:Name="TimeSecondsText"
                                       Text=":00"
                                       Margin="1,0,0,4"
                                       VerticalAlignment="Bottom"
                                       FontSize="14"
                                       Foreground="#8AFFFFFF" />
                            <TextBlock x:Name="DateText"
                                       Text="—"
                                       Margin="12,0,0,6"
                                       VerticalAlignment="Bottom"
                                       FontSize="10.5"
                                       Foreground="#7AFFFFFF" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="30,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="距今天结束" FontSize="10" Foreground="#6EFFFFFF" />
                            <TextBlock x:Name="DayRemainingText"
                                       Text="—"
                                       Margin="0,2,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E6FFFFFF" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#1AFFFFFF"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,5,12,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="6" Height="6" RadiusX="2" RadiusY="2" Fill="#FF5BE49B" VerticalAlignment="Center" />
                                <TextBlock Text="桌面" Margin="6,0,0,0" FontSize="11" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ========== 小卡片：媒体 ========== -->
                    <Grid x:Name="MediaPanel" Margin="11,9,11,9" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                            <Border CornerRadius="10" Background="#1FFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" />
                            <TextBlock Text="&#xE8D6;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="#7AFFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                            <Rectangle x:Name="ArtworkShape" RadiusX="10" RadiusY="10">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="11,0,10,0" MinWidth="240" VerticalAlignment="Center">
                            <TextBlock x:Name="TrackTitle"
                                       Text="—"
                                       MaxWidth="300"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F7FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       TextOptions.TextFormattingMode="Ideal" />
                            <TextBlock x:Name="TrackSubtitle"
                                       Text="—"
                                       MaxWidth="300"
                                       Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="#85FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="PrevButton" Style="{StaticResource IconButton}" MouseLeftButtonDown="OnPreviousClick">
                                <TextBlock Text="&#xE892;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <Border x:Name="PlayButton" Style="{StaticResource IconButton}" MouseLeftButtonDown="OnPlayPauseClick" Margin="4,0">
                                <TextBlock x:Name="PlayGlyph" Text="&#xE769;" Style="{StaticResource IconGlyph}" />
                            </Border>
                            <Border x:Name="NextButton" Style="{StaticResource IconButton}" MouseLeftButtonDown="OnNextClick">
                                <TextBlock Text="&#xE893;" Style="{StaticResource IconGlyph}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ========== 二级大面板：时钟 + 分页（通知 / 快捷） ========== -->
                <Grid x:Name="MaxPanel" Width="620" Height="212" Margin="14,14,14,14" Opacity="0"
                      MouseLeftButtonDown="OnMaxPanelMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="196" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 左：时钟（跨两行，和右侧内容等高） -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MaxTimeText" Text="00:00" FontSize="34" FontWeight="SemiBold" Foreground="#F7FFFFFF" />
                                <TextBlock x:Name="MaxSecondsText" Text=":00" Margin="1,0,0,6" VerticalAlignment="Bottom" FontSize="14" Foreground="#8AFFFFFF" />
                            </StackPanel>
                            <TextBlock x:Name="MaxDateText" Text="—" Margin="2,3,0,0" FontSize="10.5" Foreground="#7AFFFFFF" />
                            <Rectangle Height="1" Margin="0,10,0,8" Fill="#1FFFFFFF" />
                            <StackPanel x:Name="StatsHost" Orientation="Horizontal" Margin="0,2,0,0" />

                            <TextBlock x:Name="AppMemoryText"
                                       Text="本程序 —"
                                       Margin="2,8,0,0"
                                       FontSize="9.5"
                                       Foreground="#8AFFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- 右：页签 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="2,0,0,7">
                        <Border x:Name="TabNotifications" Style="{StaticResource TabChip}" Background="#26FFFFFF" MouseLeftButtonDown="OnNotificationsTabClick">
                            <TextBlock x:Name="TabNotificationsText" Text="通知" FontSize="11" Foreground="#F2FFFFFF" />
                        </Border>
                        <Border x:Name="TabShortcuts" Style="{StaticResource TabChip}" Margin="6,0,0,0" MouseLeftButtonDown="OnShortcutsTabClick">
                            <TextBlock x:Name="TabShortcutsText" Text="快捷" FontSize="11" Foreground="#7AFFFFFF" />
                        </Border>
                        <Border x:Name="TabSettings" Style="{StaticResource TabChip}" Margin="6,0,0,0" MouseLeftButtonDown="OnSettingsTabClick">
                            <TextBlock x:Name="TabSettingsText" Text="设置" FontSize="11" Foreground="#7AFFFFFF" />
                        </Border>
                    </StackPanel>

                    <!-- 右：通知页 -->
                    <Border x:Name="NotificationsPage" Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock x:Name="NotificationHeaderText" Text="系统通知" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="NotificationCountText" Text="" HorizontalAlignment="Right" FontSize="10" Foreground="#6EFFFFFF" />
                            </Grid>

                            <ScrollViewer x:Name="NotificationScroll"
                                          Grid.Row="1"
                                          Margin="0,7,0,0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly"
                                          PreviewMouseWheel="OnNotificationWheel">
                                <StackPanel x:Name="NotificationList" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右：设置页 -->
                    <Border x:Name="SettingsPage" Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="SettingsHeaderText" Text="声音与显示" Style="{StaticResource CardTitle}" />

                            <StackPanel x:Name="SettingsHost" Grid.Row="1" Margin="0,6,0,0" />
                        </Grid>
                    </Border>

                    <!-- 右：快捷页 -->
                    <Border x:Name="ShortcutsPage" Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ShortcutHeaderText" Text="快捷启动" Style="{StaticResource CardTitle}" />

                            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="ShortcutGrid" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>